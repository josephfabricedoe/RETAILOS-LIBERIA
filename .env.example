# RetailOS Liberia - Environment Variables
# Create a .env.local file with your own Firebase project credentials to completely isolate production backends

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=retailos-liberia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=retailos-liberia
VITE_FIREBASE_STORAGE_BUCKET=retailos-liberia.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
