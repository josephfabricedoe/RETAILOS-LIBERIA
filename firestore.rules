rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // MULTI-TENANT RETAILOS LIBERIA RULES
    // ==========================================
    match /businesses/{businessId} {
      allow read, write: if true;

      // Tenant Products (public read & POS operations)
      match /products/{productId} {
        allow read, write: if true;
      }

      // Tenant Sales & Orders
      match /sales/{saleId} {
        allow read, write: if true;
      }

      // Tenant Customers
      match /customers/{customerId} {
        allow read, write: if true;
      }

      // Tenant Deliveries
      match /deliveries/{deliveryId} {
        allow read, write: if true;
      }

      // Tenant Operational Subcollections (expenses, staff, attendance, shifts, etc.)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ==========================================
    // ROOT COLLECTIONS (BACKWARDS COMPATIBILITY)
    // ==========================================
    match /products/{productId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /customerTransactions/{transId} {
      allow read, write: if true;
    }
    match /customerPayments/{paymentId} {
      allow read, write: if true;
    }
    match /onlineOrders/{orderId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /shiftHandovers/{handoverId} {
      allow read, write: if true;
    }
    match /reconciliations/{docId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }
    match /storeSettings/{docId} {
      allow read, write: if true;
    }
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /restockOrders/{orderId} {
      allow read, write: if true;
    }
    match /marketingCampaigns/{campaignId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
